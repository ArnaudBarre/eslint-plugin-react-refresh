{
  "name": "eslint-plugin-react-refresh",
  "version": "0.5.4",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "scripts/bundle.ts",
    "test": "bun test",
    "lint": "eslint --max-warnings 0",
    "format": "bun format-ci --write",
    "format-ci": "prettier --ignore-path=.gitignore --check '**/*.{js,ts,json,md,yml}'",
    "check": "tsl && bun lint && bun format-ci && bun test && bun run build && cd dist && publint"
  },
  "prettier": {
    "experimentalOperatorPosition": "start"
  },
  "peerDependencies": {
    "eslint": "^9 || ^10"
  },
  "devDependencies": {
    "@arnaud-barre/eslint-config": "^7.1.0",
    "@arnaud-barre/tsl-config": "^0.1.5",
    "@typescript-eslint/parser": "^8.68.0",
    "@typescript-eslint/utils": "^8.68.0",
    "bun-types": "~1.3.14",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "tsl": "^1.0.30",
    "typescript": "~6.0"
  }
}
